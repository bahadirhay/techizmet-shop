# Salon (web-page) ile aynı Neon kullanılabilir — shop şeması ayrıdır.
# Yeni marka (ör. Anatolian Paw) için AYRI Neon projesi önerilir → docs/NEW-SITE-ANATOLIANPAW.md
#
# Neon — yerel geliştirme ve production için pooler URL kullanın (kopma azalır):
# postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# Doğrudan (pooler olmayan) URL idle sonrası "Connection Closed" hatası verebilir.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb_shop?sslmode=require"

# shop.techizmet.com (kozmetik / demo) — aynı Vercel projesinde Anatolian Paw varsa zorunlu
# DATABASE_URL_DEMO="postgresql://...@HOST-pooler.neon.tech/neondb?sslmode=require"

# Anatolian Paw ayrı Neon kullanıyorsa
# DATABASE_URL_ANATOLIANPAW="postgresql://...@HOST-pooler.neon.tech/neondb_anatolianpaw?sslmode=require"

# Bu DB içindeki mağaza satırı (demo = King Noor seed)
STORE_SITE_SLUG=demo

SESSION_SECRET="min-32-chars-change-me-in-production-ok"
ADMIN_PASSWORD="change-this-strong-password"

NEXT_PUBLIC_STORE_URL="http://localhost:5555"
NEXT_PUBLIC_SITE_URL="http://localhost:5555"

# Zamanlanmış pazaryeri sipariş çekme (Windows Görev Zamanlayıcı → GET /api/cron/marketplace/orders?secret=...)
CRON_SECRET="min-32-chars-random-cron-secret"

# GİB e-Arşiv portal (İVD kullanıcı kodu ayarlarda; parola burada önerilir)
GIB_USERNAME=""
GIB_PASSWORD=""

# E-posta — kendi SMTP sunucunuz (önerilen) veya Resend yedek
SMTP_HOST="mail.techizmet.com"
SMTP_PORT="587"
SMTP_USER="shop@techizmet.com"
SMTP_PASSWORD=""
# SMTP_SECURE="true"   # port 465 için
MAIL_FROM="King Noor <shop@techizmet.com>"

# Alternatif: https://resend.com (SMTP yoksa)
# RESEND_API_KEY=""

THEME_MIRROR_PATH="C:/My Web Sites/shop/theking-noor.myshopify.com"

# Ürün SEO AI (isteğe bağlı — admin panelden de tanımlanabilir)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
ANTHROPIC_API_KEY=""
# CLAUDE_MODEL="claude-3-5-haiku-latest"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
