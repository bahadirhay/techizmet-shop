{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/seo/distribution",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/gsc/sync?days=7",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/blog-automation/run",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/marketplace/trendyol-qna",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/orders/auto-deliver",
      "schedule": "0 5 * * *"
    }
  ],
  "build": {
    "env": {
      "GENERATE_SOURCEMAP": "false",
      "NEXT_DISABLE_SOURCEMAPS": "1",
      "MIRROR_PREBUILD_CATEGORY_BATCH": "1"
    }
  }
}
