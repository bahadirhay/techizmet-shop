{
  "name": "techizmet-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma-generate-safe.mjs && next dev --webpack -p 5555",
    "dev:paw": "node scripts/prisma-generate-safe.mjs && next dev --webpack -p 5556",
    "dev:fast": "next dev --webpack -p 5555",
    "dev:sync": "npm run mirror:prebuild && npm run dev",
    "dev:live": "node scripts/prisma-generate-safe.mjs && node scripts/dev-mirror-live.mjs",
    "build": "node scripts/vercel-build-preflight.mjs && prisma generate && node scripts/copy-tinymce.mjs && node scripts/apply-street-food-migration.mjs && node scripts/apply-wholesale-migration.mjs && node scripts/apply-marketplace-markup-migration.mjs && node scripts/apply-marketplace-commission-migration.mjs && node scripts/apply-order-shipment-meta-migration.mjs && node scripts/apply-order-billing-tax-migration.mjs && node scripts/apply-b2b-counterparty-migration.mjs && node scripts/apply-finance-invoice-order-migration.mjs && node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/prebuild-mirror-cache.ts && next build --webpack",
    "mirror:prebuild": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/prebuild-mirror-cache.ts",
    "start": "next start -p 5555",
    "lint": "eslint",
    "postinstall": "prisma generate && node scripts/copy-tinymce.mjs",
    "db:init": "prisma db execute --file scripts/create-shop-schema.sql --schema prisma/schema.prisma",
    "db:push": "npm run db:init && prisma db push",
    "db:migrate-media": "prisma db execute --file scripts/add-media-data-column.sql --schema prisma/schema.prisma",
    "db:migrate-highlights": "prisma db execute --file scripts/add-product-highlights-column.sql --schema prisma/schema.prisma",
    "db:migrate-product-categories": "prisma db execute --file scripts/add-product-category-links-table.sql --schema prisma/schema.prisma",
    "db:migrate-street-food-manual": "prisma db execute --file prisma/migrations/20260616120000_street_food_manual_contribution/migration.sql --schema prisma/schema.prisma",
    "db:migrate-wholesale": "prisma db execute --file prisma/migrations/20260617120000_product_wholesale_price/migration.sql --schema prisma/schema.prisma",
    "db:migrate-marketplace-markup": "prisma db execute --file prisma/migrations/20260618120000_product_marketplace_markup/migration.sql --schema prisma/schema.prisma",
    "db:migrate-bundles": "prisma db execute --file scripts/add-product-bundles.sql --schema prisma/schema.prisma",
    "db:migrate-product-images": "tsx scripts/migrate-product-upload-images.ts",
    "db:backfill-media": "tsx scripts/backfill-store-media-uploads.ts",
    "db:seed": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:seed-demo-nav": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/seed-demo-nav.ts",
    "theme:import": "node scripts/import-theme-mirror.mjs && node scripts/build-mirror-home.mjs && node scripts/build-mirror-products.mjs && node scripts/build-mirror-collections.mjs && node scripts/build-mirror-pages.mjs && node scripts/build-mirror-blogs.mjs",
    "blog:import-mirror": "npx tsx scripts/import-blog-posts-from-mirror.ts",
    "db:sync-blog-images": "tsx scripts/sync-blog-images.ts",
    "db:sync-media:all": "npm run db:sync-images:all && npm run db:sync-collection-images && npm run db:sync-blog-images",
    "theme:seed-blog": "npx tsx scripts/seed-featured-blog.ts",
    "theme:seed-branding": "npx tsx scripts/seed-site-branding.ts",
    "theme:fix-tr-corruption": "node scripts/fix-mirror-tr-corruption.mjs",
    "theme:fix-images": "npx tsx scripts/fix-mirror-html-images.mjs",
    "catalog:extract": "node scripts/extract-mirror-variants.mjs && npm run db:sync-content:all && npm run db:sync-images:all",
    "db:sync-images": "node scripts/sync-product-images.mjs",
    "db:sync-images:all": "tsx scripts/sync-all-mirror-images.ts",
    "db:sync-collection-images": "tsx scripts/sync-collection-images.ts",
    "db:seed-explore": "tsx scripts/seed-default-explore-looks.ts",
    "db:sync-home:mirror": "tsx scripts/sync-mirror-home-page.ts",
    "db:ensure-mirror": "node scripts/ensure-mirror-homepage.mjs",
    "theme:strip-scripts": "node scripts/strip-mirror-shopify-scripts.mjs",
    "mirror:sanitize": "npx tsx scripts/sanitize-mirror-html.mjs",
    "mirror:audit-shopify": "npx tsx scripts/audit-shopify-remnants.mjs",
    "db:sync-content": "node scripts/sync-product-content.mjs",
    "db:sync-content:all": "tsx scripts/sync-all-mirror-content.ts",
    "reset:admin": "tsx scripts/reset-admin.ts",
    "store:provision": "tsx scripts/provision-empty-store.ts",
    "store:provision:anatolianpaw": "tsx scripts/provision-empty-store.ts --preset=anatolianpaw --slug=anatolianpaw --name=Anatolian Paw --url=https://anatolianpaw.com",
    "store:seed:anatolianpaw": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/seed-anatolianpaw-assets.ts",
    "store:seed:anatolianpaw:blog": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/seed-anatolianpaw-blog.ts --env-file=.env.anatolianpaw",
    "setup:paw": "powershell -ExecutionPolicy Bypass -File scripts/setup-anatolianpaw.ps1",
    "setup:paw:prod": "powershell -ExecutionPolicy Bypass -File scripts/setup-anatolianpaw-production.ps1",
    "build:check": "node --require ./scripts/shim-server-only.cjs ./node_modules/tsx/dist/cli.mjs scripts/check-vercel-build-ready.ts --prebuild --env-file=.env.anatolianpaw"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@geliver/sdk": "^1.3.0",
    "@prisma/client": "6.19.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "fatura": "^0.2.1",
    "iron-session": "^8.0.4",
    "isomorphic-dompurify": "^3.16.0",
    "jsbarcode": "^3.12.3",
    "linkedom": "^0.18.12",
    "nanoid": "^5.1.11",
    "next": "16.2.4",
    "nodemailer": "^8.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tinymce": "^8.6.0",
    "turkey-neighbourhoods": "^4.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "6.19.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "jsdom": "26.1.0",
    "html-encoding-sniffer": "4.0.0"
  }
}
